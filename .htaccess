Options -MultiViews +FollowSymlinks -Indexes
RewriteEngine On


# Block internet scanners (LeakIX, Censys, Palo Alto Xpanse, zgrab, RedTail)
RewriteCond %{HTTP_USER_AGENT} (l9explore|l9tcpid|CensysInspect|Palo\ Alto\ Networks|zgrab|libredtail) [NC]
RewriteRule .* - [F,L]

# Answer them with plain text instead of error.php (no PHP, no session)
<If "%{HTTP_USER_AGENT} =~ /(l9explore|l9tcpid|CensysInspect|Palo Alto Networks|zgrab|libredtail)/i">
	ErrorDocument 403 "Forbidden"
</If>



# Apache 2.4 syntax (order/deny only worked through mod_access_compat)
<Files ".ht*">
	Require all denied
</Files>


ErrorDocument 400 /error.php?errorid=400
ErrorDocument 401 /error.php?errorid=401
ErrorDocument 403 /error.php?errorid=403
ErrorDocument 404 /error.php?errorid=404
ErrorDocument 500 /error.php?errorid=500

# //seo_mod_start
# Uncomment the following and add your tracker path if rewrites arent working properly
#RewriteBase /
RewriteRule ^index.html$ index.php [L,NE]

RewriteRule ^[a-z0-9_]*-a-([a-f0-9]{32})$ announce.php?passkey=$1 [QSA,L]


RewriteRule ^user-([0-9]+)\.html$ member.php?action=profile&id=$1 [L,QSA]


RewriteRule ^forum-([0-9]+)\.html$ forumdisplay.php?fid=$1 [L,QSA]
RewriteRule ^forum-([0-9]+)-page-([0-9]+)\.html$ forumdisplay.php?fid=$1&page=$2 [L,QSA]
	
RewriteRule ^thread-([0-9]+)\.html$ showthread.php?tid=$1 [L,QSA]
RewriteRule ^thread-([0-9]+)-page-([0-9]+)\.html$ showthread.php?tid=$1&page=$2 [L,QSA]
RewriteRule ^thread-([0-9]+)-lastpost\.html$ showthread.php?tid=$1&action=lastpost [L,QSA]
RewriteRule ^thread-([0-9]+)-nextnewest\.html$ showthread.php?tid=$1&action=nextnewest [L,QSA]
RewriteRule ^thread-([0-9]+)-nextoldest\.html$ showthread.php?tid=$1&action=nextoldest [L,QSA]
RewriteRule ^thread-([0-9]+)-newpost\.html$ showthread.php?tid=$1&action=newpost [L,QSA]
RewriteRule ^thread-([0-9]+)-post-([0-9]+)\.html$ showthread.php?tid=$1&pid=$2 [L,QSA]
RewriteRule ^post-([0-9]+)\.html$ showthread.php?pid=$1 [L,QSA]

RewriteRule ^torrent-([0-9]+)-comment-([0-9]+)\.html$ details.php?id=$1&pid=$2 [L,QSA]
RewriteRule ^comment-([0-9]+)\.html$ details.php?pid=$1 [L,QSA]


RewriteRule ^torrent-([0-9]+)\.html$ details.php?id=$1 [L,QSA]
RewriteRule ^torrent-([0-9]+)-page-([0-9]+)\.html$ details.php?id=$1&page=$2 [L,QSA]

RewriteRule ^download-([0-9]+)\.html$ download.php?id=$1 [L,QSA]

RewriteRule ^announcement-([0-9]+)\.html$ announcements.php?aid=$1 [L,QSA]

RewriteRule ^category-([0-9]+)\.html$ browse.php?category=$1 [L,QSA]
RewriteRule ^category-([0-9]+)-page-([0-9]+)\.html$ browse.php?category=$1&page=$2 [L,QSA]


# //seo_mod_end

# "mod_expires" without .c never matched, so this block was skipped
<IfModule mod_expires.c>
	<FilesMatch "\.(gif|jpg|jpeg|png|webp|svg|ico|woff2?|css|js)$">
		ExpiresActive On
		ExpiresDefault "access plus 10 years"
	</FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header unset Last-Modified
</IfModule>

FileETag none
php_flag short_open_tag on
# register_globals was removed in PHP 5.4 - the line did nothing